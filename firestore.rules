rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection health check route
    match /test/{testId} {
      allow read: if true;
    }

    // User profile: only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User decks
      match /decks/{deckId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(deckId);
        allow delete: if isOwner(userId) && isValidId(deckId);

        // Cards under deck
        match /cards/{cardId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidId(cardId);
          allow delete: if isOwner(userId) && isValidId(cardId);
        }
      }

      // User study logs
      match /studyLogs/{logId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(logId);
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
